<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- Top Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="#0f172a"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_exam_active_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Java Examination"
            android:textColor="#ffffff"
            android:textSize="16sp"
            android:textStyle="bold"
            android:singleLine="true" />

        <!-- Live Ticking Timer -->
        <TextView
            android:id="@+id/tv_countdown_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10:00"
            android:textColor="#34d399"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="#162c26"
            android:padding="6dp"
            android:layout_marginRight="8dp" />

        <Button
            android:id="@+id/btn_finish_submit"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Submit"
            android:textColor="#ffffff"
            android:background="@color/success"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card_dark"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_q_progress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Question 1 of 4"
                    android:textColor="@color/primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_q_points"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10 Points"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_q_statement"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Question prompt goes here"
                android:textColor="#ffffff"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="20dp"
                android:lineSpacingExtra="4dp" />

            <!-- Options RadioGroup -->
            <RadioGroup
                android:id="@+id/rg_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <!-- RadioButtons dynamically injected -->
            </RadioGroup>

            <!-- Bottom Navigation Bar inside card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btn_flag_review"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="🚩 Flag"
                    android:textColor="#f59e0b"
                    android:background="@color/bg_dark"
                    android:textSize="12sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/btn_prev_question"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Prev"
                    android:textColor="#cbd5e1"
                    android:background="@color/bg_dark"
                    android:textSize="12sp"
                    android:layout_marginRight="8dp" />

                <Button
                    android:id="@+id/btn_next_question"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Next"
                    android:textColor="#ffffff"
                    android:background="@color/primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
